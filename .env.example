NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

GROQ_API_KEY=
NEXT_PUBLIC_STELLAR_NETWORK=stellar-testnet
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Server-only. Never prefix with NEXT_PUBLIC_ — this must not reach the
# browser bundle. Only needed once a server action/route handler needs
# privileged writes (e.g. admin tooling that bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=

# Authenticates external cron requests to /api/crons/process-payments.
# Set this same value as the Authorization Bearer token in cron-job.org.
# Generate with: openssl rand -hex 32
CRON_SECRET=
